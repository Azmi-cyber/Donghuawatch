NEXT_PUBLIC_API_BASE=https://www.sankavollerei.web.id/anime

# Login Google (NextAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Buat dengan: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Komentar (Upstash Redis REST). Di Vercel: Storage/Marketplace → Upstash Redis, env terisi otomatis.
# Tanpa ini komentar hanya tersimpan di memori (mode demo, tidak permanen).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin panel premium (/admin/premium). Pisahkan dengan koma.
ADMIN_EMAILS=
